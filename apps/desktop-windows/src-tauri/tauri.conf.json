{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HeyCleo",
  "version": "0.3.0",
  "identifier": "com.delight.cleonotch",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420 http://127.0.0.1:1420 ws://localhost:1420 http://localhost:1420"
    },
    "windows": [
      {
        "label": "island",
        "title": "HeyCleo",
        "url": "index.html",
        "width": 240,
        "height": 28,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": true,
        "center": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=CalculateWindowOcclusion,msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-backgrounding-occluded-windows --disable-renderer-backgrounding --autoplay-policy=no-user-gesture-required"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../target/release/cleo-hook.exe": "cleo-hook.exe",
      "../target/release/coucou-hook.exe": "coucou-hook.exe"
    },
    "copyright": "© 2026 Delight Chukwu",
    "category": "DeveloperTool",
    "shortDescription": "Smart on-screen companion for your AI agent sessions",
    "longDescription": "CleoNotch puts an intelligent companion at the top of your screen: it shows your Claude Code, Cursor, and Codex sessions and integrations, and lets you approve, answer, chat and drop files without leaving what you are doing.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "French"],
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAwRUVGNUI3RkIyQ0JCNUYKUldSZnV5ejd0L1h1QU1yUzJFdytuVXZ5cU9JSzB3WXNpNE5kcElDQkRHZ0x4M3BrVUk4aFlwWVEK",
      "endpoints": [
        "https://github.com/delightc123/CleoNotch/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
